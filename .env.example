DATABASE_URL=postgresql+asyncpg://user:password@db:5432/mydatabase
SECRET_KEY=mysecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydatabase

# Redis
REDIS_URL=redis://redis:6379/0

# SMTP (Mailpit for development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@gestorcustos.local

# Notification settings
DAYS_BEFORE_DUE_NOTIFICATION=3

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
FRONTEND_URL=http://localhost:5173

# Admin (leave empty to use SECRET_KEY)
ADMIN_SECRET_KEY=

# Ngrok (para tunelamento — obtenha em https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# Evolution API (WhatsApp) — ative com: docker compose --profile whatsapp up
# Dentro do Docker a URL deve apontar para o nome do serviço
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=evolution-dev-key
